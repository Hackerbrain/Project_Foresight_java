# Copy to .env (never commit .env). Used with --spring.profiles.active=mysql or postgres
DB_URL=jdbc:mysql://localhost:3306/smart_inventory?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
# Set to false in any shared/production environment so demo accounts are not created
APP_SEED_ENABLED=true
